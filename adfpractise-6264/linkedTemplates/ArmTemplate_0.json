																	"physicalType": "nvarchar"
																}
															}
														],
														"typeConversion": true,
														"typeConversionSettings": {
															"allowDataTruncation": true,
															"treatBooleanAsNumber": false
														}
													}
												},
												"inputs": [
													{
														"referenceName": "DS_Excel_Source",
														"type": "DatasetReference",
														"parameters": {
															"pFileName": "Advanced_Complex_Sales_Workbook.xlsx",
															"pSheetName": {
